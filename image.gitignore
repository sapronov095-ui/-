<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Открытка для бабушки</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #fce4ec;
            font-family: 'Arial', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            margin: 0;
        }
        .container {
            background-color: rgba(255, 255, 255, 0.9);
            padding: clamp(1rem, 4vw, 2rem);
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            max-width: 700px;
            width: 100%;
            text-align: center;
        }
        .container img {
            display: block;
            width: 100%;
            height: auto;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }
        .back-link {
            display: inline-block;
            margin-top: 25px;
            color: #ad1457;
            text-decoration: none;
            font-weight: bold;
            font-size: clamp(1rem, 2.5vw, 1.2rem);
            padding: 12px 24px;
            border-radius: 30px;
            background: #fce4ec;
            transition: background 0.2s;
        }
        .back-link:hover { background: #f8bbd0; text-decoration: underline; }
        .back-link:active { background: #f48fb1; }
    </style>
</head>
<body>
    <div class="container">
        <!-- Теперь картинка берется из вашей папки -->
        <img src="babushka.jpg" alt="Открытка для бабушки">
        
        <a href="greeting.html" class="back-link">⟵ Назад к поздравлению</a>
    </div>
</body>
</html>